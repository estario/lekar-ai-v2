# Browser configuration: obtain your project's public values from Lovable Cloud.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration; never prefix these secrets with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_API_KEY=
SONIOX_API_KEY=

# Optional migration/cron credentials, required only for those workflows.
LOVABLE_DB_MIGRATION_URL=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
